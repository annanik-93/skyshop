<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
		 xmlns:xsi="http://w3.org"
		 xsi:schemaLocation="http://apache.org https://apache.org">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.skypro</groupId>
	<artifactId>skyshop</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Skyshop</name>
	<description>Spring Boot Skyshop application with error handling</description>
	<properties>
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<!-- Стартер для создания веб-приложений и REST API -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Полноценный стартер для JUnit 5 и SpringBootTest тестов -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Библиотека Apache Commons Lang для работы со строками и временем -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>